# OnionGuard AI - Environment Variables Template
# Copy this file to .env and configure for production deployment

# Optional External AI Vision Model Endpoints
VITE_AI_API_URL=https://api.roboflow.com/onion-quality-v1
VITE_AI_API_KEY=your_secure_api_key_here

# Default Stage 1 Onion Confidence Gatekeeper Threshold (0.0 to 1.0)
VITE_DEFAULT_ONION_CONFIDENCE=0.70

# Default AGMARK Commercial Standards Version
VITE_GRADING_STANDARD=AGMARK_2026_COMMERCIAL
